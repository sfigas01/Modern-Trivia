# Copy this file to .env for local development.
# Never commit .env or real secret values.
# Production values live in Railway service variables (see
# docs/guides/railway_deployment.md); this file documents names only.

# Required: PostgreSQL connection used by the app and Drizzle.
# On Railway this is a reference to the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modern_trivia

# Required: session encryption secret (generate with: openssl rand -hex 32).
# Use a different value in every environment.
SESSION_SECRET=replace-with-a-strong-random-secret

# Optional: port the server listens on. Defaults to 5000. On Railway set it to
# 5000 so it matches the port the public domain routes to.
PORT=5000

# Public base URL of the app, without a trailing slash, e.g.
# https://superquestly.up.railway.app. Required in production: the Google
# sign-in redirect URI is PUBLIC_URL + /api/callback and must match the
# redirect URI registered on the Google OAuth client exactly. Also used at
# build time for absolute og:image URLs. Defaults to http://localhost:PORT
# outside production.
PUBLIC_URL=

# Required for sign-in: Google OAuth "Web application" client credentials
# (Google Cloud console → Google Auth Platform → Clients). Any Google account
# can sign in as a player; admin rights come only from the admin_roles table.
# When unset, /api/login returns 503 and the rest of the app still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: used for local tooling/scripts that call the Linear API.
LINEAR_API_KEY=your-linear-api-key-here

# Required for question generation, Guardian review and dispute analysis:
# a direct, project-scoped OpenAI API key.
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional: custom OpenAI-compatible endpoint. Leave unset to use the OpenAI
# SDK default (https://api.openai.com/v1).
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional: gates multiplayer room UI (host/join/room routes). Defaults to false.
# Read at build time by Vite, so set it before the build runs.
VITE_MULTIPLAYER=false

# Optional: gates player-requested themed games (STE-167 lean MVP) — theme entry,
# suggested categories, themed question generation, and the waiting UX. Read on
# both the client (Vite build) and the server (theme routes). Defaults to false;
# when off, ordinary category games are completely unchanged.
VITE_THEME_ROUNDS=false

# Optional: permits the legacy on-demand themed generator while the source-first
# reliability pipeline is under development. Defaults to false when unset.
THEME_LIVE_GENERATION=false

# Optional: API key for scripted admin access (e.g. content quality sweeps).
# When set, requests with an `Authorization: Bearer <key>` header bypass the
# browser sign-in session check. Store as a Railway variable; never commit a
# real value. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# The users.id that API key requests act as. Must exist in the admin_roles
# table or admin checks will 403. Existing ids are preserved by the Railway
# migration (sign-in matches users by email). Defaults to 'service-account'
# when unset.
ADMIN_API_KEY_USER_ID=
